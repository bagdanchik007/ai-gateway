# --- App ---
APP_ENV=local              # local | staging | production
APP_DEBUG=true
APP_PORT=8000
SECRET_KEY=change-me-to-a-random-64-char-string

# --- Database (Postgres) ---
POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway
POSTGRES_DB=ai_gateway
POSTGRES_PORT=5432
# Собирается автоматически в docker-compose; переопредели для локального запуска без Docker:
DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/ai_gateway

# --- Redis (rate limiting, кэш, usage counters) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- LLM Providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
# Локальный / self-hosted OpenAI-совместимый провайдер (Ollama, vLLM, LM Studio и т.д.)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=not-needed

# --- Rate limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60
